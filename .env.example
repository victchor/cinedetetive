# Copie para .env e preencha. O .env real nunca vai para o Git.

# --- Banco (Postgres + pgvector no Docker: infra/docker-compose.yml) ---
DATABASE_URL=postgresql://cinedetetive:cinedetetive@localhost:5432/cinedetetive

# --- Ollama (nativo no Windows) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- TMDB (themoviedb.org > Settings > API > "API Read Access Token") ---
TMDB_READ_TOKEN=

# --- Langfuse (cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agente (FastAPI) ---
CORS_ORIGIN=http://localhost:3000
